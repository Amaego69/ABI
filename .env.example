# Copy to .env and fill in real values (do NOT commit .env).
# GITHUB_* must point at the separate buggy-app repository, not this product repo.
# Tokens are created manually by a human — never by the agent.

# GitHub (created manually by a human, NOT the agent)
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Anthropic API
ANTHROPIC_API_KEY=
# API model id (not the UI label). Default: claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5

# Langfuse (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/bug_investigator

# Redis
REDIS_URL=redis://redis:6379/0

# --- Optional runtime tweaks ---
# BUGGY_APP_BASE_URL=http://127.0.0.1:8001
# REQUIRE_PR_APPROVAL=true
# AUTO_CREATE_PR=false
# RUNS_ROOT=/tmp/runs
# SANDBOX_IMAGE=bug-investigator-sandbox:latest
# Host directory mirrored into api as /tmp/runs (for sandbox bind mounts via docker.sock)
# Windows Docker Desktop example: SANDBOX_BIND_ROOT=D:/AAI/Automated_Bug_Investigator/data/runs
# SANDBOX_BIND_ROOT=/tmp/bug-investigator-runs
